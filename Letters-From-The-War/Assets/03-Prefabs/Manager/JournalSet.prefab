  m_Script: {fileID: 11500000, guid: 90034d1dd237a78418c51287f334f25c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  worldImages: []
  worldImage: {fileID: 0}
  journalImage: {fileID: 0}
  journalNoImage: {fileID: 0}
  journalForImage: {fileID: 0}
  headlineText: {fileID: 0}
  dayOne:
    range:
      minRangeFirstTitle: 0
      maxRangeFirstTitle: 0
      minRangeSecondTitle: 1
      maxRangeSecondTitle: 1
      minRangeThirdTitle: 2
      maxRangeThirdTitle: 2
      minRangeFourthTitle: 3
      maxRangeFourthTitle: 3
    descriptions:
      descriptionFirstRange: The People of Vitulia stand by their young heroes at
        the front, by working hard and fulfilling their challenging duties. We truly
        are a great nation
      descriptionSecondRange: Despite an anti-vitualian movement spreading disinformation
        to undermine our Nation, Vitulia maintains the resolute support of its citizens!
      descriptionThirdRange: Small groups of agitators caught spreading disinformation,
        silenced for the sake of truth and the safety of our citizens
      descriptionFourthRange: 
  dayTwo:
    range:
      minRangeFirstTitle: 0
      maxRangeFirstTitle: 0
      minRangeSecondTitle: 1
      maxRangeSecondTitle: 2
      minRangeThirdTitle: 3
      maxRangeThirdTitle: 4
      minRangeFourthTitle: 5
      maxRangeFourthTitle: 6
    descriptions:
      descriptionFirstRange: We are winning the war! Thanks to the hard work of its
        men and women, Vitulia is proving its worth to the other nations
      descriptionSecondRange: Anti-nationalistic fringes boycott Vitulian efforts
        by spreading false information
      descriptionThirdRange: Anti-nationalistic fringes boycott Vitulian efforts
        by accusing the Government of wasting resources on the war
      descriptionFourthRange: 
  dayThree:
    range:
      minRangeFirstTitle: 0
      maxRangeFirstTitle: 0
      minRangeSecondTitle: 1
      maxRangeSecondTitle: 1
      minRangeThirdTitle: 2
      maxRangeThirdTitle: 4
      minRangeFourthTitle: 5
      maxRangeFourthTitle: 6
    descriptions:
      descriptionFirstRange: Soldiers at the front are happy to know that thanks
        to them we will emerge stronger from the war
      descriptionSecondRange: Anti-war protesters on the streets. Police escort them
        away peacefully
      descriptionThirdRange: Anti-war protesters on the streets. The Government will
        not tolerate any more liars and will act accordingly
      descriptionFourthRange: "Government forces suppress the anti-war protesters.
        A spokesperson for the people states, \u201CWe will come again to reveal
        the truth about the war\u201D"
  dayFour:
    range:
      minRangeFirstTitle: 0
      maxRangeFirstTitle: 0
      minRangeSecondTitle: 1
      maxRangeSecondTitle: 2
      minRangeThirdTitle: 3
      maxRangeThirdTitle: 5
      minRangeFourthTitle: 6
      maxRangeFourthTitle: 8
    descriptions:
      descriptionFirstRange: 'Vitulian people interviewed: Pride for our youth and
        the happiness of seeing them soon'
      descriptionSecondRange: 'Vitulian people interviewed: Concern about the situation
        our youth are living at the front'
      descriptionThirdRange: 'Vitulian people interviewed: Despair in the words of
        some parents about the future of their sons at the front'
      descriptionFourthRange: 'Rumors of a possible insurrection denied by the authorities:
        means to drag the people down'
  dayFive:
    range:
      minRangeFirstTitle: 0
      maxRangeFirstTitle: 0
      minRangeSecondTitle: 1
      maxRangeSecondTitle: 3
      minRangeThirdTitle: 4
      maxRangeThirdTitle: 7
      minRangeFourthTitle: 8
      maxRangeFourthTitle: 10
    descriptions:
      descriptionFirstRange: Radical change! The war will end soon!
      descriptionSecondRange: Citizens hope to see their relatives soon. It has been
        over a year since the war started
      descriptionThirdRange: "After over a year since the war started, some citizens
        seem to have lost faith in seeing their relatives again. The Government reassures:
        \u201CIt will be over soon with your help and support\u201D"
      descriptionFourthRange: People gathered outside Parliament to ask about their
        relatives at the front, and were reassured by the Government
  daySix:
    range:
      minRangeFirstTitle: 0
      maxRangeFirstTitle: 0
      minRangeSecondTitle: 1
      maxRangeSecondTitle: 3
      minRangeThirdTitle: 4
      maxRangeThirdTitle: 10
      minRangeFourthTitle: 11
      maxRangeFourthTitle: 12
    descriptions:
      descriptionFirstRange: Vitulian Government is asking for economic support from
        the citizens to bring back our soldiers even sooner
      descriptionSecondRange: "Vitulian Government is asking for economic support
        from the citizens. People wonder how  the war is really going on\r"
      descriptionThirdRange: Citizens want to leave the country, scared of the war.
        Government reassures them and asks for support
      descriptionFourthRange: Citizens are leaving the country and taking to the
        streets. The government is lying and now people want the truth
  daySeven:
    range:
      minRangeFirstTitle: 0
      maxRangeFirstTitle: 0
      minRangeSecondTitle: 1
      maxRangeSecondTitle: 3
      minRangeThirdTitle: 4
      maxRangeThirdTitle: 10
      minRangeFourthTitle: 11
      maxRangeFourthTitle: 14
    descriptions:
      descriptionFirstRange: Enemy soldiers occupied the streets of our main cities!
        Citizens are in disbelief
      descriptionSecondRange: Enemy soldiers have crossed the borders and are now
        in our main cities! Some citizens are locking themselves in their houses
        and others are trying to leave the country
      descriptionThirdRange: Enemy soldiers have crossed the borders and are in our
        main cities! Citizens are leaving their houses to approach them and ask for
        help
      descriptionFourthRange: Riotous people from the opposition are joining enemy
        soldiers on the streets against our government to support the citizens. Our
        Heads of State are being held captive
